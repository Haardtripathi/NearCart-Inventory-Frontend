VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=NearCart Inventory
# Branch/shop location picker (map pin + search + reverse-geocode) on the Branches page. Reuse the
# same key already used by the sibling NearCart/backend repo's GOOGLE_MAPS_API_KEY. Leave unset to
# fall back to manual lat/lng + address entry only (always available regardless — the map is a
# convenience layered on top, never the only way to set a branch's location).
VITE_GOOGLE_MAPS_API_KEY=
